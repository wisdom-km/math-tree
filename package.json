{
  "name": "math-tree",
  "private": true,
  "version": "0.1.0",
  "description": "人教版小学数学知识树教学系统（六年级上册）",
  "type": "module",
  "packageManager": "pnpm@10.33.3",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "content:check": "vitest run tests/content.test.ts",
    "db:generate": "drizzle-kit generate",
    "tauri": "tauri"
  },
  "dependencies": {
    "@mathigon/euclid": "^1.2.4",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-sql": "^2.4.1",
    "drizzle-orm": "^0.44.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "yaml": "^2.8.1",
    "zod": "^3.25.76"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^22.15.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "drizzle-kit": "^0.31.10",
    "typescript": "~5.9.3",
    "vite": "^6.4.3",
    "vitest": "^3.2.7"
  }
}
